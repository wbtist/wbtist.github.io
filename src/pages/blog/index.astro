---
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await Astro.glob('./*.md');
// Sort posts by date, newest first (if pubDate exists)
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate || 0);
  const dateB = new Date(b.frontmatter.pubDate || 0);
  return dateB.getTime() - dateA.getTime();
});
---

<BaseLayout title="Blog | Istvan Toth">
  <main class="container">
    <div class="blog-header reveal delay-1">
      <h1 class="text-gradient">Blog</h1>
      <p>Thoughts, project deep-dives, and tutorials.</p>
    </div>

    <div class="posts-grid reveal delay-2">
      {sortedPosts.map((post) => (
        <a href={post.url} class="post-card glass-panel">
          <article>
            <h2>{post.frontmatter.title}</h2>
            <div class="post-meta">
              <span class="date">{post.frontmatter.pubDate && new Date(post.frontmatter.pubDate).toLocaleDateString()}</span>
            </div>
            <p class="description">{post.frontmatter.description}</p>
            <span class="read-more action-link">Read Post</span>
          </article>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  main {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .blog-header p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .post-card {
    display: block;
    padding: 2.5rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .post-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 107, 0, 0.3);
  }

  .post-card h2 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .post-card:hover h2 {
    color: var(--accent-primary);
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .description {
    margin-bottom: 2rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .read-more {
    display: inline-flex;
    margin-top: auto;
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
